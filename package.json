{
  "name": "hockey-manager",
  "private": true,
  "scripts": {
    "data:europe": "node scripts/build-europe-data.cjs",
    "check:europe": "node scripts/build-europe-data.cjs --check && node --test european-leagues.test.cjs",
    "dev": "vite --host 0.0.0.0 --port 4173",
    "test:match-lab": "node match-simulation.test.cjs",
    "data:match-lab": "node scripts/export-match-lab.cjs",
    "test:career-match": "node career-match.test.cjs && node career-match-rules.test.cjs",
    "test:match-realism": "node match-realism.test.cjs && node career-realism.test.cjs",
    "check:match-balance": "node scripts/match-balance.cjs",
    "test:development": "node development.test.cjs",
    "test": "node --test --test-concurrency=3 *.test.cjs",
    "check:match-balance-wide": "node scripts/match-balance-wide.cjs",
    "test:career-long": "node scripts/career-long-run.cjs",
    "check:match-modes": "node scripts/compare-match-modes.cjs",
    "check:playback-parity": "node scripts/check-playback-parity.cjs",
    "check:background-strength": "node scripts/check-background-strength.cjs",
    "sample:ai-calibration": "node scripts/sample-ai-calibration.cjs",
    "check:ai-calibration": "node scripts/check-ai-calibration.cjs",
    "check:ai-overtime": "node scripts/check-ai-overtime.cjs",
    "desktop:install": "npm ci --prefix desktop",
    "desktop:start": "npm start --prefix desktop",
    "desktop:windows": "npm run dist:win --prefix desktop"
  },
  "devDependencies": {
    "vite": "8.0.13"
  }
}
